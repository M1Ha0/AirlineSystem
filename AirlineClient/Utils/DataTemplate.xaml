<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:AirlineClient.ViewModels"
                    xmlns:view="clr-namespace:AirlineClient.Views">

    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <view:HomeView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:FlightViewModel}">
        <view:FlightView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CrewViewModel}">
        <view:CrewView />
    </DataTemplate>

</ResourceDictionary>
