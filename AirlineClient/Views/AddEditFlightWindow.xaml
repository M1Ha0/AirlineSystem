<Window x:Class="AirlineClient.Views.AddEditFlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рейс" Height="500" Width="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource GlassWindowBg}" BorderBrush="{StaticResource GlassWindowBorder}" BorderThickness="1.5" CornerRadius="16" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="TitleText" Text="Добавление рейса" FontSize="18" FontWeight="Bold" Foreground="#0C4A6E" VerticalAlignment="Center"/>
                <Button Style="{StaticResource CloseBtnStyle}" HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Номер рейса" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtNumber" Margin="0,0,0,8" TextChanged="Input_TextChanged"/>

                <TextBlock Text="Тип воздушного судна" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtAircraft" Margin="0,0,0,8" TextChanged="Input_TextChanged"/>

                <TextBlock Text="Откуда" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtDeparture" Margin="0,0,0,8" TextChanged="Input_TextChanged"/>

                <TextBlock Text="Куда" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtDestination" Margin="0,0,0,8" TextChanged="Input_TextChanged"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Дата вылета (DatePicker)" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                        <DatePicker x:Name="DpDate" Height="32" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Время (ЧЧ:ММ)" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtTime" Text="12:00"
                                 PreviewTextInput="TxtTime_PreviewTextInput"
                                 TextChanged="Input_TextChanged"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Статус рейса" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                <ComboBox x:Name="CmbStatus" Margin="0,0,0,8"/>

                <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Отмена" Style="{StaticResource RedBtnStyle}" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Сохранить" Style="{StaticResource BlueBtnStyle}" Width="120" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
