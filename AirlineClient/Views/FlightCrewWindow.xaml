<Window x:Class="AirlineClient.Views.FlightCrewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Формирование экипажа" Height="540" Width="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource GlassWindowBg}" BorderBrush="{StaticResource GlassWindowBorder}" BorderThickness="1.5" CornerRadius="16" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="TxtHeader" Text="Экипаж рейса" FontSize="18" FontWeight="Bold" Foreground="#0C4A6E"/>
                    <TextBlock x:Name="TxtSubHeader" FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource CloseBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click"/>
            </Grid>

            <!-- Панель назначения сотрудника из БД -->
            <Border Grid.Row="1" Background="{StaticResource GlassCardBg}" BorderBrush="{StaticResource GlassCardBorder}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Должность" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbRole" SelectionChanged="CmbRole_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Сотрудник из базы данных" FontSize="11" Foreground="#475569" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbStaff" DisplayMemberPath="DisplayInfo"/>
                    </StackPanel>

                    <Button Grid.Column="4" Content="Назначить" Style="{StaticResource BlueBtnStyle}" VerticalAlignment="Bottom" Height="32" Click="Assign_Click"/>
                </Grid>
            </Border>

            <!-- Таблица назначенного экипажа -->
            <DataGrid Grid.Row="2" x:Name="GridAssigned" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Должность" Width="130" Binding="{Binding AssignedRole}"/>
                    <DataGridTextColumn Header="ФИО сотрудника" Width="220" Binding="{Binding CrewMember.FullName}"/>
                    <DataGridTextColumn Header="Таб. №" Width="80" Binding="{Binding CrewMember.EmployeeNumber}"/>
                    <DataGridCheckBoxColumn Header="Допуск ВЛЭК" Width="*" Binding="{Binding CrewMember.MedicalClearance}"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Статус готовности -->
            <Border Grid.Row="3" x:Name="StatusBorder" Background="#CCFFFFFF" BorderBrush="#99BAE6FD" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,10">
                <TextBlock x:Name="TxtReadiness" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <Grid Grid.Row="4">
                <Button Content="Удалить выбранного" Style="{StaticResource RedBtnStyle}" HorizontalAlignment="Left" Click="Remove_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Полетный манифест" Style="{StaticResource BlueBtnStyle}" Margin="0,0,8,0" Click="Manifest_Click"/>
                    <Button Content="Готово" Style="{StaticResource BlueBtnStyle}" Width="90" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
