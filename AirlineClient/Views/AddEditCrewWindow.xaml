<Window x:Class="AirlineClient.Views.AddEditCrewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник" Height="390" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource GlassWindowBg}" BorderBrush="{StaticResource GlassWindowBorder}" BorderThickness="1.5" CornerRadius="16" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="TitleText" Text="Добавление сотрудника" FontSize="18" FontWeight="Bold" Foreground="#0C4A6E" VerticalAlignment="Center"/>
                <Button Style="{StaticResource CloseBtnStyle}" HorizontalAlignment="Right" Click="Cancel_Click"/>
            </Grid>

            <StackPanel Grid.Row="1">
                <TextBlock Text="ФИО сотрудника" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtFullName" Margin="0,0,0,10" TextChanged="Input_TextChanged"/>

                <TextBlock Text="Должность" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                <ComboBox x:Name="CmbRole" Margin="0,0,0,10"/>

                <TextBlock Text="Табельный номер (только цифры)" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox x:Name="TxtEmpNumber" Margin="0,0,0,8"
                         PreviewTextInput="TxtEmpNumber_PreviewTextInput"
                         PreviewKeyDown="TxtEmpNumber_PreviewKeyDown"
                         DataObject.Pasting="TxtEmpNumber_Pasting"
                         TextChanged="Input_TextChanged"/>

                <CheckBox x:Name="ChkMedical" Content="Действующий медицинский допуск (ВЛЭК)" IsChecked="True" FontSize="13" Foreground="#0F172A" Margin="0,2,0,8"/>

                <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Отмена" Style="{StaticResource RedBtnStyle}" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Сохранить" Style="{StaticResource BlueBtnStyle}" Width="120" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
