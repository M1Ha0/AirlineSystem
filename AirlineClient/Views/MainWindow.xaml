<Window x:Class="AirlineClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AirlineClient.ViewModels"
        xmlns:Menu="clr-namespace:AirlineClient.Utils"
        Title="Авиакомпания" Height="580" Width="1020"
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:NavigationViewModel/>
    </Window.DataContext>

    <Border Background="{StaticResource GlassWindowBg}" BorderBrush="{StaticResource GlassWindowBorder}" BorderThickness="1.5" CornerRadius="18" MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель навигации -->
            <Border Grid.Column="0" Background="{StaticResource GlassSidebarBg}" CornerRadius="18,0,0,18" BorderBrush="#99BAE6FD" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="18,22,18,18">
                        <TextBlock Text="Авиакомпания" FontSize="19" FontWeight="Bold" Foreground="#0C4A6E"/>
                        <TextBlock Text="Учет рейсов и экипажей" FontSize="11" Foreground="#475569" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,6">
                        <Menu:Btn Style="{StaticResource NavBtnStyle}" Command="{Binding HomeCommand}" IsChecked="True">
                            <Grid>
                                <Image Source="/Assets/img_home.png" Style="{StaticResource NavIconStyle}"/>
                                <TextBlock Text="Главная" Style="{StaticResource NavTextStyle}"/>
                            </Grid>
                        </Menu:Btn>

                        <Menu:Btn Style="{StaticResource NavBtnStyle}" Command="{Binding FlightCommand}">
                            <Grid>
                                <Image Source="/Assets/flight.png" Style="{StaticResource NavIconStyle}"/>
                                <TextBlock Text="Рейсы" Style="{StaticResource NavTextStyle}"/>
                            </Grid>
                        </Menu:Btn>

                        <Menu:Btn Style="{StaticResource NavBtnStyle}" Command="{Binding CrewCommand}">
                            <Grid>
                                <Image Source="/Assets/passenger.png" Style="{StaticResource NavIconStyle}"/>
                                <TextBlock Text="Персонал" Style="{StaticResource NavTextStyle}"/>
                            </Grid>
                        </Menu:Btn>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#80FFFFFF" CornerRadius="10" Margin="12" Padding="10,8" BorderBrush="#99BAE6FD" BorderThickness="1">
                        <TextBlock Text="{Binding UserDisplay}" FontSize="11" Foreground="#334155" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Основная область -->
            <Grid Grid.Column="1">
                <Border Background="{StaticResource GlassContentBg}" CornerRadius="0,18,18,0">
                    <ContentControl Content="{Binding CurrentView}" Margin="16,42,16,16"/>
                </Border>

                <Button Style="{StaticResource CloseBtnStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0" Click="CloseApp_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
