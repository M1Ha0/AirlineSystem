<Window x:Class="AirlineClient.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AirlineClient.ViewModels"
        Title="Регистрация" Height="370" Width="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:RegisterViewModel/>
    </Window.DataContext>

    <Border Background="{StaticResource GlassWindowBg}" BorderBrush="{StaticResource GlassWindowBorder}" BorderThickness="1.5" CornerRadius="16" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="Регистрация" FontSize="19" FontWeight="Bold" Foreground="#0C4A6E" VerticalAlignment="Center"/>
                <Button Style="{StaticResource CloseBtnStyle}" HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="ФИО" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock Text="Email (логин)" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                <TextBlock Text="Роль" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="0,0,0,14">
                <TextBlock Text="Пароль" FontSize="12" Foreground="#475569" Margin="0,0,0,3"/>
                <PasswordBox x:Name="RegPassword"/>
            </StackPanel>

            <Button Grid.Row="5" Content="Создать аккаунт" Style="{StaticResource BlueBtnStyle}" Height="36"
                    Command="{Binding RegisterCommand}" CommandParameter="{Binding ElementName=RegPassword}"/>
        </Grid>
    </Border>
</Window>
